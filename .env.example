# Copiar para .env e preencher com os dados do projeto Supabase.
# O .env está no .gitignore e nunca deve ser commitado (§10.1).
#
# Em produção, as duas variáveis vão no painel da Netlify, não em arquivo.
#
# Só a anon key entra aqui. A service_role key NUNCA vai para o front —
# ela ignora a RLS e daria acesso total ao banco a quem abrir o bundle.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
